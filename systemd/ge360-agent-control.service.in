[Unit]
Description=GE360 Agent Control Center
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=__USER__
Group=__GROUP__
WorkingDirectory=__ROOT__
Environment=HOME=__HOME__
Environment=CODEX_HOME=__HOME__/.codex
Environment=PATH=__HOME__/.local/bin:/usr/local/bin:/usr/bin:/bin
Environment=PYTHONUNBUFFERED=1
Environment=GE360_AGENT_CONFIG=/etc/ge360-agent/config.toml
ExecStart=__ROOT__/.venv/bin/python -m ge360_agent.main
Restart=on-failure
RestartSec=3
TimeoutStopSec=15

[Install]
WantedBy=multi-user.target
